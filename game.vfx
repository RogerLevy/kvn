require savegame.vfx

public

: control
    <t> pressed? if clock toggle then
    <m> pressed? if mute toggle then
    options-key-pressed?
        if s" options" gevent then
;

: muting  mute @ not 0.25 and gain ;

: render  crt>  backsprites  bg  sprites  hud ;

: think  generate animate step ?travel instalment control muting ;

: init-state ( - )
    divest  
    0 0 to gametime  
    clear-world ;

: new ( - )
    init-state  load-world
    0 warp
    ?kvn to p1  ;

: game ( - )
    game/ public
    can-save on
    hush
    show> render think ;

redef : restart ( - )
    blank blank blank blank  new game ;

: retry ( - )
    blank blank  ?kvn to p1  game ;

: boot-kvn ( - )
    \ Kickoff
    init-supershow 
    0 gamelife !
    debug @ if
        new game
    else
        save-exists? if resume game else new game then
    then ;

: ?save
    \ Automatic saving
    debug @ ?exit
    can-save @ -exit
    p1 -> falling @ ?exit
    save ;

' ?save atexit

' boot-kvn is boot
