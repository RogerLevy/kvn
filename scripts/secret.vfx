class: secret
    actor derive
class;

secret :: init
    \ vanish
    act>
        me p1 hit? -exit
        *beep17* 1 #secrets +!
        bg.ts 22 tile bmp ! 
        -0.9 vy !
    act>
        vy @ 0.88 p* vy !
        vy @ -0.05 > -exit
    act>
        vy @ 0.9 p* vy !
        mstime 75 / 1 and 0<> bg.ts 22 tile and bmp !
        1.0 passed? -exit
        me unload ;
