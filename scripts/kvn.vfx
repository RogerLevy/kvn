require scripts\crumbler.vfx

kvn.png 8 8 +tileset kvn.ts
kvn.ts animation walk.anm    0 11 range,
kvn.ts animation jump.anm    46 frame,
kvn.ts animation climb.anm   34 45 range,
kvn.ts animation fall.anm    12 13 range,
kvn.ts animation splat.anm   14 33 range,

class: kvn
    %actor derive
    is-a %platformer

    -4 -3 8 7 solidity-hitbox!

    .12 gravity !
    1.5 terminal-vy !
    1.55 jump-power !
    .09 rise-power !
    .75 walk-speed !
    .75 terminal-vx !
    .08 air-control !
class;

\ Animation
: ?footstep  a.done @ -exit *beep16* a.done off ;
: movelegs  vx @ abs 2 / 0.1 + .75 min a.spd ! ?footstep ;
: ?walk.anm  anm @ walk.anm = ?exit  walk.anm 0 cycle ;
: ?idle.anm  anm @ walk.anm = if  0 a.spd !  then  ?walk.anm ;

\ Physics phase
: kvn-physics  platformer-physics ; \ ?plummet ?travel ?spikes ?collect ;

\ Sound
: land-sound  sfx @ beep13.wav = if 0 sfx ! then *beep12* ;

\ Logic
class: kvn
:: ->jump  platformer:->jump jump.anm 1. cycle *beep14* ;
:: ->walk  platformer:->walk +act> movelegs ;
:: ->idle  platformer:->idle +act> movelegs ;
:: ->fall  platformer:->fall jump.anm 1. cycle ;
:: ->land  platformer:->land land-sound ;
:: init  playable /platformer ?idle.anm ;
class;