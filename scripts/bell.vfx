class: %bell
    %actor derive
    prop ctr
class;

bitmap assets/gfx/bell.png
bell.png 24 8 tileset-from bell.ts
bell.ts animation ring.anm  1 frame, 1 frame, 0 frame, 2 frame, 2 frame, 0 frame, 

: ring  
    ring.anm 0.2 cycle 
    0 ctr !
    begin 1 ctr +! *bell* act> 0.25 passed? -exit ctr @ 18 = until 
    anm off  bell.ts 0 tile bmp ! ;

%bell :: init
    bell.ts 0 tile bmp ! 
    act> me p1 hit? -exit ring ;
