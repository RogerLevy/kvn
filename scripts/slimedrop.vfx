class: slimedrop
    %actor derive
    prop gravity :fixed
    prop terminal-vy :fixed

    0.025 gravity !
    1. terminal-vy !
class;

: physics
    vy @ gravity @ + terminal-vy @ min vy !
    -3 -3 6 6 playfield tmcol>
        floor? if *beep7* me unload then ;

slimedrop :: init
    bg.ts 7 tile bmp !
    ['] physics phys !
    -1 -1 x1 2! 2 2 w1 2!
    act> me p1 hit? -exit me unload s" slimed" gevent ;
