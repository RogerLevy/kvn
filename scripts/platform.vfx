\ Moving Platform Actor
\ Based on Cave Story platform mechanics (ActNpc149/157)
\ Implements solid platform collision with player

class: %platform
    %actor derive
    prop flags  \ same as tile metadata
class;

\ ------------------------------------------------------------------------------
\ Collision Side Detection (Cave Story algorithm from MycHit.cpp:654)
\ Determines if collision is primarily vertical (top/bottom) or horizontal (left/right)

: boxmid@ ( - x. y. )
    { x 2@`` x1 2@ 2>p`` 2+`` w1 2@ 2>p 2 2 2/`` 2+ } ;

: vertical? ( - flag )
    {: | dx dy hw hh :}
    \ Calculate distances between centers (absolute values)
    p1 boxmid@ me boxmid@ 2- abs to dy abs to dx 

    \ Calculate combined half-widths and half-heights
    p1 -> w1 2@ 2>p`` w1 2@ 2>p`` 2+ 2 2 2/ to hh to hw     \ (player.width + platform.width) / 2

    \ Check if dy*hw > dx*hh
    dy hw p*` dx hh p*` > ;

\ ------------------------------------------------------------------------------
\ Player Position Adjustment

: push-player-up
    \ Set player Y to sit on top of platform
    \ player.y = platform.y - platform.y1 - platform.h1 - player.h1 - player.y1
    y @ y1 @ >p -` h1 @ >p` -                    \ Platform top edge
    p1 -> h1 @ >p -` p1 -> y1 @ >p` -            \ Subtract player height and offset
    p1 -> y ! ;

: push-player-down
    \ Push player down to platform bottom
    \ player.y = platform.y + platform.y1 + player.y1
    y @ y1 @ >p +` p1 -> y1 @ >p` +
    p1 -> y ! ;

: push-player-left
    \ Push player to left of platform
    \ player.x = platform.x - platform.x1 - platform.w1 - player.w1 - player.x1
    x @ x1 @ >p -` w1 @ >p` -
    p1 -> w1 @ >p -` p1 -> x1 @ >p` -
    p1 -> x ! ;

: push-player-right
    \ Push player to right of platform
    \ player.x = platform.x + platform.x1 + platform.w1 + player.x1
    x @ x1 @ >p + w1 @ >p +` p1 -> x1 @ >p` +
    p1 -> x ! ;

\ ------------------------------------------------------------------------------
\ Riding Behavior (Cave Story MycHit.cpp:738-744)

: player-on-top? ( - flag )
    \ Player must be above platform center and falling/moving down
    p1 -> y @ y @ <
    p1 -> vy @ 0 >= and ;

: make-player-ride
    \ Player inherits platform velocity
    push-player-up

    \ Match vertical velocity (for future moving platforms)
    vy @ p1 -> vy !

    \ Move horizontally with platform (for future moving platforms)
    vx @ p1 -> x +!

    \ Set player as standing on ground
    p1 ->land ;

\ ------------------------------------------------------------------------------
\ Crush Detection

: solid-tile-at? ( x y - flag )
    \ Check if there's a solid tile at pixel coordinates
    \ TODO: support directional solidity flags
    xy>cr playfield spot @ solid? ;

: check-crush-left ( - crushed? )
    \ Check if player is crushed against left wall
    \ Player's left edge
    p1 -> x @ p1 -> x1 @ >p + 4. -   \ X position, slightly to the left
    p1 -> y @ p1 -> y1 @ >p + p1 -> h1 @ >p 2 / +  \ Y position at center
    solid-tile-at? ;

: check-crush-right ( - crushed? )
    \ Player's right edge
    p1 -> x @ p1 -> x1 @ >p + p1 -> w1 @ >p + 4. +
    p1 -> y @ p1 -> y1 @ >p + p1 -> h1 @ >p 2 / +
    solid-tile-at? ;

: check-crush-up ( - crushed? )
    \ Player's top edge
    p1 -> x @ p1 -> x1 @ >p + p1 -> w1 @ >p 2 / +
    p1 -> y @ p1 -> y1 @ >p + 4. -
    solid-tile-at? ;

: check-crush-down ( - crushed? )
    \ Player's bottom edge
    p1 -> x @ p1 -> x1 @ >p + p1 -> w1 @ >p 2 / +
    p1 -> y @ p1 -> y1 @ >p + p1 -> h1 @ >p + 4. +
    solid-tile-at? ;

: handle-crush-damage
    \ Deal 100 damage like Cave Story (adjust as needed)
    -100 p1 -> hp +! ;

\ ------------------------------------------------------------------------------
\ Main Collision Handler

: handle-vertical-collision
    player-on-top? if
        flags @ BIT_FLR and -exit
        make-player-ride
    else
        flags @ BIT_CEL and -exit
        \ Player hit platform from below
        push-player-down
        \ Check for crush against ceiling
        check-crush-up if handle-crush-damage then
    then ;

: handle-horizontal-collision
    \ Determine if player is to left or right
    p1 -> x @ x @ < if
        flags @ BIT_WLT and -exit
        \ Player is to the left
        push-player-left
        check-crush-left if handle-crush-damage then
    else
        flags @ BIT_WRT and -exit
        \ Player is to the right
        push-player-right
        check-crush-right if handle-crush-damage then
    then ;

: platform-collision
    \ Main collision handler called each frame
    \ Only interact with player
    p1 -exit                    \ No player exists
    me p1 hit? -exit            \ Not colliding with player

    \ Determine collision axis and respond
    vertical? if
        handle-vertical-collision
    else
        handle-horizontal-collision
    then ;

\ ------------------------------------------------------------------------------
\ Physics

public
: platform-physics
    platform-collision ;

